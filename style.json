{
  "version": 8,
  "name": "Yeezik Night",
  "metadata": { "author": "Yeezik", "description": "Stile notte blu-viola con percorso rosa, per iPhone e CarPlay" },
  "sources": {
    "openmaptiles": { "type": "vector", "url": "https://tiles.openfreemap.org/planet" }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "background", "type": "background", "paint": { "background-color": "#1f2278" } },

    { "id": "landuse-residential", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["residential", "suburb", "neighbourhood"]]],
      "paint": { "fill-color": "#22267f" } },
    { "id": "landuse-commercial", "type": "fill", "source": "openmaptiles", "source-layer": "landuse",
      "filter": ["in", ["get", "class"], ["literal", ["commercial", "retail", "industrial"]]],
      "paint": { "fill-color": "#262a88" } },
    { "id": "park", "type": "fill", "source": "openmaptiles", "source-layer": "park",
      "paint": { "fill-color": "#1f4a45", "fill-opacity": 0.9 } },
    { "id": "landcover-green", "type": "fill", "source": "openmaptiles", "source-layer": "landcover",
      "filter": ["in", ["get", "class"], ["literal", ["grass", "wood", "farmland"]]],
      "paint": { "fill-color": "#1f4a45", "fill-opacity": 0.75 } },
    { "id": "water", "type": "fill", "source": "openmaptiles", "source-layer": "water",
      "paint": { "fill-color": "#12165a" } },
    { "id": "waterway", "type": "line", "source": "openmaptiles", "source-layer": "waterway",
      "paint": { "line-color": "#12165a", "line-width": ["interpolate", ["linear"], ["zoom"], 10, 1, 18, 6] } },

    { "id": "road-minor", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["minor", "service", "track"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#5a5ed0", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 13, 0.6, 18, 10] } },
    { "id": "road-path", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["path", "pedestrian"]]],
      "paint": { "line-color": "#4a4fc0", "line-width": ["interpolate", ["linear"], ["zoom"], 14, 0.5, 18, 3], "line-dasharray": [2, 1.5] } },
    { "id": "road-secondary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["secondary", "tertiary"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#6d6cc9", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 10, 1, 18, 18] } },
    { "id": "road-primary", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["primary", "trunk"]]],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#7c79bf", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 8, 1, 18, 26] } },
    { "id": "road-motorway", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["==", ["get", "class"], "motorway"],
      "layout": { "line-cap": "round", "line-join": "round" },
      "paint": { "line-color": "#8a86c8", "line-width": ["interpolate", ["exponential", 1.6], ["zoom"], 6, 1, 18, 32] } },
    { "id": "rail", "type": "line", "source": "openmaptiles", "source-layer": "transportation",
      "filter": ["in", ["get", "class"], ["literal", ["rail", "transit"]]],
      "paint": { "line-color": "#3a3fa8", "line-width": 1.5, "line-dasharray": [3, 2] } },

    { "id": "building-3d", "type": "fill-extrusion", "source": "openmaptiles", "source-layer": "building", "minzoom": 14,
      "paint": {
        "fill-extrusion-color": "#4a53e3",
        "fill-extrusion-height": ["*", 0.6, ["coalesce", ["get", "render_height"], 8]],
        "fill-extrusion-base": ["*", 0.6, ["coalesce", ["get", "render_min_height"], 0]],
        "fill-extrusion-opacity": 0.92
      } },

    { "id": "road-label", "type": "symbol", "source": "openmaptiles", "source-layer": "transportation_name", "minzoom": 14,
      "layout": {
        "symbol-placement": "line",
        "text-field": ["coalesce", ["get", "name:it"], ["get", "name"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": ["interpolate", ["linear"], ["zoom"], 14, 10, 18, 14],
        "text-letter-spacing": 0.02
      },
      "paint": { "text-color": "#d6d4ff", "text-halo-color": "#1f2278", "text-halo-width": 1.4 } },

    { "id": "poi", "type": "symbol", "source": "openmaptiles", "source-layer": "poi", "minzoom": 15,
      "filter": ["<=", ["coalesce", ["get", "rank"], 99], 30],
      "layout": {
        "icon-image": ["match", ["get", "class"],
          ["restaurant", "fast_food", "cafe", "bar", "pub", "ice_cream", "bakery"], "yz-food",
          ["lodging"], "yz-bed",
          ["shop", "clothing_store", "grocery", "shoe_shop", "jewelry"], "yz-shop",
          ["hospital", "doctors", "pharmacy", "dentist"], "yz-health",
          ["fuel", "car"], "yz-car",
          "yz-pin"],
        "icon-size": 0.5,
        "icon-anchor": "bottom",
        "text-field": ["coalesce", ["get", "name:it"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": 13,
        "text-anchor": "top",
        "text-offset": [0, 0.2],
        "text-max-width": 8,
        "icon-padding": 6
      },
      "paint": { "text-color": "#ffffff", "text-halo-color": "#1a1c66", "text-halo-width": 1.6 } },

    { "id": "place-label", "type": "symbol", "source": "openmaptiles", "source-layer": "place",
      "filter": ["in", ["get", "class"], ["literal", ["city", "town", "suburb", "quarter", "neighbourhood"]]],
      "layout": {
        "text-field": ["coalesce", ["get", "name:it"], ["get", "name"]],
        "text-font": ["Noto Sans Bold"],
        "text-size": ["match", ["get", "class"], "city", 18, "town", 15, 12],
        "text-transform": "uppercase",
        "text-letter-spacing": 0.12
      },
      "paint": { "text-color": "#a9a6ff", "text-halo-color": "#1f2278", "text-halo-width": 1.5 } }
  ]
}
